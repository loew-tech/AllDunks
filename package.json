{
  "name": "alldunks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic phase-based 3-on-3 basketball rules prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
